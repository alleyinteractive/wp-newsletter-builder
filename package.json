{
  "name": "wp-newsletter-builder",
  "version": "1.0.0",
  "license": "GPL-2.0-or-later",
  "main": "plugin.php",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "browserslist": [
    "defaults",
    "not IE 11"
  ],
  "scripts": {
    "build": "alley-build build",
    "create-block": "node ./bin/create-block",
    "precheck-types": "check-node-version --package",
    "check-types": "tsc",
    "eslint:fix": "eslint --ext .jsx --ext .js --ext .ts --ext .tsx . --fix",
    "eslint": "npm run check-types && eslint --ext .jsx --ext .js --ext .ts --ext .tsx .",
    "packages-update": "alley-build packages-update --dist-tag=wp-6.8",
    "postinstall": "rm -rf node_modules/.cache/babel-loader && rm -rf node_modules/.cache/webpack",
    "prebuild": "check-node-version --package",
    "predev": "check-node-version --package",
    "preinstall": "check-node-version --package",
    "prelint:fix": "check-node-version --package",
    "prelint": "check-node-version --package",
    "prestylelint:fix": "check-node-version --package",
    "prestylelint": "check-node-version --package",
    "pretest:watch": "check-node-version --package",
    "pretest": "check-node-version --package",
    "release": "npx @alleyinteractive/create-release@latest",
    "start": "alley-build start",
    "start:hot": "alley-build start --hot",
    "stylelint:fix": "stylelint --fix \"**/*.scss\"",
    "stylelint": "stylelint \"**/*.scss\" --allow-empty-input",
    "jest:watch": "jest --watch",
    "jest": "jest --passWithNoTests",
    "test": "npm run eslint && npm run jest"
  },
  "dependencies": {
    "@alleyinteractive/block-editor-tools": "^0.11",
    "@types/jest": "^30.0.0",
    "@types/wordpress__block-editor": "^11.5.7",
    "@wordpress/api-fetch": "^7.19.2",
    "@wordpress/block-editor": "^14.14.6",
    "@wordpress/blocks": "^14.8.2",
    "@wordpress/components": "^29.5.4",
    "@wordpress/core-data": "^7.19.6",
    "@wordpress/create-block": "^4.62.1",
    "@wordpress/data": "^10.19.2",
    "@wordpress/dom-ready": "^4.19.1",
    "@wordpress/edit-post": "^8.19.7",
    "@wordpress/element": "^6.19.1",
    "@wordpress/hooks": "^4.19.1",
    "@wordpress/html-entities": "^4.19.1",
    "@wordpress/i18n": "^5.19.1",
    "@wordpress/plugins": "^7.19.4",
    "@wordpress/url": "^4.19.2",
    "array-move": "^4.0.0",
    "axios": "^1.13.2",
    "classnames": "^2.5.1",
    "cross-spawn": "^7.0.6",
    "dompurify": "^3.3.1",
    "entities": "^8.0.0",
    "lodash": "^4.17.23",
    "prompts": "^2.4.2",
    "prop-types": "^15.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-easy-sort": "^1.8.0",
    "react-multi-select-component": "^4.3.4",
    "uuid": "^14.0.0",
    "wp-types": "^4.69.0"
  },
  "devDependencies": {
    "@alleyinteractive/build-tool": "^0.3.0",
    "@alleyinteractive/eslint-config": "^0.2.0",
    "@alleyinteractive/stylelint-config": "^0.2.0",
    "@babel/preset-env": "^7.28.6",
    "@types/wordpress__edit-post": "^7.5.5",
    "@wordpress/babel-preset-default": "^8.19.1",
    "@wordpress/scripts": "^30.12.1",
    "babel-jest": "^30.2.0",
    "check-node-version": "^4.2.1",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^13.0.1",
    "jest": "^30.3.0",
    "mini-css-extract-plugin": "^2.10.2",
    "ts-jest": "^29.4.9",
    "typescript": "^5.9.3",
    "webpack-cli": "^6.0.1"
  }
}
